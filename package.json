{
  "name": "osu-beatmap-processor",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build-windows": "rmdir dist /s /q & pnpm build",
    "build-linux": "rm -rf dist & pnpm build",
    "start": "node --trace-warnings .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src tests",
    "format:check": "prettier --check src tests"
  },
  "keywords": [],
  "packageManager": "pnpm@11.5.2",
  "author": "Rian8337",
  "license": "MIT",
  "description": "A dedicated backend for processing and caching osu! beatmaps.",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@rian8337/osu-base": "4.0.0-beta.96",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.1",
    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "p-queue": "^9.3.3",
    "pg": "^8.21.0",
    "pg-native": "^3.8.0",
    "zod": "^3.25.76"
  }
}
