{
    "name": "osu-beatmap-processor",
    "version": "2.0.0",
    "private": true,
    "description": "A dedicated backend for processing and caching osu! beatmaps.",
    "author": "Rian8337",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.mjs",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.9.1",
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch --on-success \"node dist/index.mjs\"",
        "start": "node dist/index.mjs",
        "cli": "node dist/cli.mjs",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.mts",
        "lint": "oxlint --fix",
        "format": "oxfmt",
        "db:generate": "drizzle-kit generate",
        "db:baseline": "node dist/cli.mjs db-baseline"
    },
    "dependencies": {
        "@rian8337/osu-base": "4.0.0-beta.102",
        "cors": "^2.8.6",
        "drizzle-orm": "^0.45.4",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "p-queue": "^9.3.5",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.9",
        "@electric-sql/pglite-socket": "^0.2.12",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^5.0.4",
        "drizzle-kit": "^0.31.11",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2004",
        "supertest": "^7.3.1",
        "tsdown": "^0.23.1",
        "typescript": "^7.0.2",
        "vitest": "^5.0.4"
    }
}
